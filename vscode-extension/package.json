{
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tokentracker.openDashboard",
        "title": "%command.openDashboard%"
      },
      {
        "command": "tokentracker.showServerInfo",
        "title": "%command.showServerInfo%"
      },
      {
        "command": "tokentracker.configureOtel",
        "title": "%command.configureOtel%"
      },
      {
        "command": "tokentracker.importLocalTraces",
        "title": "%command.importLocalTraces%"
      },
      {
        "command": "tokentracker.refreshStatus",
        "title": "%command.refreshStatus%"
      },
      {
        "command": "tokentracker.startServer",
        "title": "%command.startServer%"
      },
      {
        "command": "tokentracker.stopServer",
        "title": "%command.stopServer%"
      }
    ],
    "configuration": [
      {
        "title": "%config.group.display%",
        "properties": {
          "tokentracker.statusBarFormat": {
            "default": "$(pulse) {hit} · {ttft} · {speed} · {cost}",
            "description": "%config.statusBarFormat%",
            "type": "string",
            "order": 1
          },
          "tokentracker.statusBarCost": {
            "default": "session",
            "description": "%config.statusBarCost%",
            "enum": [
              "session",
              "model"
            ],
            "enumDescriptions": [
              "%config.statusBarCost.session%",
              "%config.statusBarCost.model%"
            ],
            "type": "string",
            "order": 2
          },
          "tokentracker.statsRange": {
            "default": "7d",
            "description": "%config.statsRange%",
            "enum": [
              "today",
              "7d",
              "30d",
              "all"
            ],
            "enumDescriptions": [
              "%config.statsRange.today%",
              "%config.statsRange.7d%",
              "%config.statsRange.30d%",
              "%config.statsRange.all%"
            ],
            "type": "string",
            "order": 2
          },
          "tokentracker.costUnit": {
            "default": "cny",
            "description": "%config.costUnit%",
            "enum": [
              "cny",
              "usd",
              "credit"
            ],
            "enumDescriptions": [
              "%config.costUnit.cny%",
              "%config.costUnit.usd%",
              "%config.costUnit.credit%"
            ],
            "type": "string",
            "order": 3
          },
          "tokentracker.creditRate": {
            "default": 0.01,
            "description": "%config.creditRate%",
            "minimum": 0.0001,
            "type": "number",
            "order": 4
          },
          "tokentracker.usdRate": {
            "default": 7.2,
            "description": "%config.usdRate%",
            "minimum": 0.01,
            "type": "number",
            "order": 5
          }
        }
      },
      {
        "title": "%config.group.server%",
        "properties": {
          "tokentracker.port": {
            "default": 4318,
            "description": "%config.port%",
            "type": "number",
            "order": 1
          },
          "tokentracker.autoStart": {
            "default": true,
            "description": "%config.autoStart%",
            "type": "boolean",
            "order": 2
          },
          "tokentracker.idleExitSeconds": {
            "default": 5,
            "description": "%config.idleExitSeconds%",
            "minimum": 0,
            "type": "number",
            "order": 3
          },
          "tokentracker.serverDownloadBaseUrl": {
            "default": "",
            "description": "%config.serverDownloadBaseUrl%",
            "type": "string",
            "order": 4
          }
        }
      }
    ]
  },
  "description": "%description%",
  "homepage": "https://github.com/JottingCN/TokenTracker#readme",
  "bugs": {
    "url": "https://github.com/JottingCN/TokenTracker/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "~5.6.3"
  },
  "displayName": "Token Tracker",
  "engines": {
    "vscode": "^1.90.0"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "tokentracker",
  "publisher": "JottingCN",
  "repository": {
    "type": "git",
    "url": "https://github.com/JottingCN/TokenTracker.git"
  },
  "scripts": {
    "build": "npm run compile && npm run sync-server",
    "compile": "tsc -p .",
    "pretest": "npm run compile",
    "test": "node --test",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --no-dependencies",
    "smoke": "node scripts/smoke-server.mjs",
    "sync-server": "node scripts/sync-server.mjs"
  },
  "version": "0.1.8"
}
