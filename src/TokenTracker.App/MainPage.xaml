<Page
    x:Class="TokenTracker_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TokenTracker_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,16,24,20" RowSpacing="14" MinHeight="1040">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Copilot OTel 本地看板 · 主调用命中率 / 费用"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="{x:Bind ViewModel.ReceiverStatus, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ReceivedText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <ComboBox
                            x:Name="RangeBox"
                            Width="110"
                            SelectedIndex="2"
                            SelectionChanged="RangeBox_SelectionChanged">
                            <ComboBoxItem Content="今天" />
                            <ComboBoxItem Content="昨天" />
                            <ComboBoxItem Content="近 7 天" />
                            <ComboBoxItem Content="近 30 天" />
                            <ComboBoxItem Content="全部" />
                        </ComboBox>

                        <ToggleSwitch
                            x:Name="UtilitySwitch"
                            IsOn="False"
                            OffContent="含辅助调用"
                            OnContent="含辅助调用"
                            Toggled="UtilitySwitch_Toggled" />

                        <Button Content="刷新" Click="RefreshButton_Click" />

                        <Button Content="复制 Copilot 配置" Click="CopyConfigButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Model breakdown -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="190" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="按模型" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="12,0,0,0" Text="模型" Style="{StaticResource HeaderTextStyle}" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="调用" Style="{StaticResource HeaderTextStyle}" />
                                <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="输入 / 缓存" Style="{StaticResource HeaderTextStyle}" />
                                <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="命中率" Style="{StaticResource HeaderTextStyle}" />
                                <TextBlock Grid.Column="4" Margin="12,0,0,0" Text="估算费用" Style="{StaticResource HeaderTextStyle}" />
                            </Grid>
                        </Border>

                        <ScrollViewer
                            Grid.Row="1"
                            AutomationProperties.Name="模型统计"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ModelsPanel" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Sessions and calls -->
            <Grid Grid.Row="2" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="280" />
                    <RowDefinition Height="340" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="会话" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="4,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="12,0,0,0" Text="标题" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="模型" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="调用" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="输入" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="4" Margin="12,0,0,0" Text="缓存" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="5" Margin="12,0,0,0" Text="命中" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="6" Margin="12,0,0,0" Text="输出" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="7" Margin="12,0,0,0" Text="思考" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="8" Margin="12,0,0,0" Text="估算费用" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="9" Margin="12,0,0,0" Text="最近" Style="{StaticResource HeaderTextStyle}" />
                                </Grid>
                            </Border>

                            <ScrollViewer
                                Grid.Row="1"
                                AutomationProperties.Name="会话统计"
                                HorizontalContentAlignment="Stretch"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SessionsPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近调用" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="4,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="12,0,0,0" Text="时间" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="标题" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="模型" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="输入" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="4" Margin="12,0,0,0" Text="缓存" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="5" Margin="12,0,0,0" Text="输出" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="6" Margin="12,0,0,0" Text="命中" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="7" Margin="12,0,0,0" Text="估算费用" Style="{StaticResource HeaderTextStyle}" />
                                    <TextBlock Grid.Column="8" Margin="12,0,0,0" Text="时段" Style="{StaticResource HeaderTextStyle}" />
                                </Grid>
                            </Border>

                            <ScrollViewer
                                Grid.Row="1"
                                AutomationProperties.Name="最近调用"
                                HorizontalContentAlignment="Stretch"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CallsPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="4,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="费用为基于 DeepSeek、Kimi、小米 MiMo、MiniMax、智谱 GLM 公开价目表的估算（CNY），与 GitHub Copilot 订阅账单无关；命中率下降不一定代表缓存失效。数据来自 Copilot OTel，经本机 4318 接收后存入本地 SQLite，保留 90 天。" />
        </Grid>
    </ScrollViewer>
</Page>
